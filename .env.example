# Kopiera till .env.local. Checka ALDRIG in riktiga värden.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=

# Supabase (lokalt: värden från `supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL läses bara på servern (src/server/db/pool.ts, D-019), aldrig i
# klienten. Lokalt: containern nedan. Prod-värdet (Supavisor, transaction mode,
# port 6543) sätts i WP-05, aldrig här.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Krävs när DATABASE_URL inte är lokal: Supabase root CA (PEM) från
# dashboarden (Project Settings → Database → SSL). Servern vägrar starta utan
# den och kräver verifierad TLS (rejectUnauthorized). Radbrytningar får
# skrivas som \n. Tomt lokalt.
DATABASE_CA_CERT=

# Kryptering av tredjepartstokens (32 byte, base64)
ENCRYPTION_KEY=

# WhatsApp Cloud API (Meta, D-063). Se docs/tech/INTEGRATIONS.md §1.
# Utan WHATSAPP_ACCESS_TOKEN + WHATSAPP_PHONE_NUMBER_ID skickas inget på
# WhatsApp: allt går som e-post, utom i fejkläget nedan.
WHATSAPP_PHONE_NUMBER_ID=
# Permanent systemanvändartoken (Business Manager → System users).
WHATSAPP_ACCESS_TOKEN=
# Appens hemlighet (App Dashboard → Settings → Basic): signaturen
# X-Hub-Signature-256 på webhooken. Tom = webhooken svarar 503.
WHATSAPP_APP_SECRET=
# Valfri lång slumpsträng; samma värde skrivs in i Meta när webhooken
# registreras (GET-verifieringen). Tom = verifieringen nekas.
WHATSAPP_VERIFY_TOKEN=
# Graph API-version (standard v23.0).
WHATSAPP_GRAPH_VERSION=
# DEN ENDA PUNKTEN som slår på mallar: kommaseparerade Meta-namn som Meta har
# GODKÄNT. Tomt = WhatsApp används inte (allt som e-post). URL-mallarna
# (reserva_confirmada, reserva_cancelada, reserva_movida) läggs till först när
# domänen är bestämd och Meta godkänt dem med den domänen.
# Alla sex: reserva_confirmada,recordatorio_24h,reserva_cancelada,reserva_movida,lista_espera_oferta,lista_espera_tomada
WHATSAPP_TEMPLATES_APPROVED=
# "1" = fejkläge lokalt/CI/e2e utan nycklar: meddelandena sparas i minnet,
# inget skickas. Ignoreras i Vercels production-miljö.
WHATSAPP_FAKE=

# E-post (tomt = fake-provider)
RESEND_API_KEY=
EMAIL_FROM=

# Mercado Pago (OAuth-app för handpenning via företagens egna konton)
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=

# Flow (vårt abonnemang)
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_API_URL=https://sandbox.flow.cl/api

# Observabilitet
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# Öppnar /design-lab i Vercels "production"-miljö (bara staging, se docs/tech/STAGING.md).
# Sätt ALDRIG till "1" i riktig produktion. Tomt/annat värde = stängt (samma som idag).
DESIGN_LAB=

# AI-import "Flytta hit från ditt nuvarande bokningssystem" (WP-66, D-046).
# Tom nyckel (och inget fejkläge) = funktionen döljs (D-035).
ANTHROPIC_API_KEY=
# Valfri modell (standard claude-haiku-5-5).
AI_IMPORT_MODEL=
# Globalt månadstak i USD; över taket pausas importen. Standard 80.
AI_IMPORT_MONTHLY_BUDGET_USD=80
# "1" = fejkläge lokalt/CI: realistisk fixture, inget API-anrop.
AI_IMPORT_FAKE=
