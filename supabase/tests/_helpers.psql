-- Delade fixturer för pgTAP-testerna i WP-01.
-- Två företag (A, B) och fem användare: ownerA, ownerB, staffA (roll staff),
-- vendorA (roll vendor), nomember (utan medlemskap). `anon` är en inbyggd
-- roll utan rättigheter i public (INV-3), ingen fixtur behövs för den.
-- Körs som postgres (superuser), som förbigår RLS.
--
-- Rollbyte i testerna:
--   set local role authenticated;
--   select set_config('request.jwt.claims', json_build_object('sub', <uuid>, 'role', 'authenticated')::text, true);
-- Tillbaka till postgres (för att kontrollera rader utan RLS): `reset role;`
-- Som anon: `set local role anon;` (inga policies matchar ändå, se INV-3).

insert into auth.users (id, email, role, aud) values
  ('11111111-1111-1111-1111-111111111111', 'ownera@example.com', 'authenticated', 'authenticated'),
  ('22222222-2222-2222-2222-222222222222', 'ownerb@example.com', 'authenticated', 'authenticated'),
  ('33333333-3333-3333-3333-333333333333', 'staffa@example.com', 'authenticated', 'authenticated'),
  ('44444444-4444-4444-4444-444444444444', 'vendora@example.com', 'authenticated', 'authenticated'),
  ('55555555-5555-5555-5555-555555555555', 'nomember@example.com', 'authenticated', 'authenticated');

